[Unit]
Description=GAF Backend (gunicorn WSGI)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=gaf
Group=gaf
WorkingDirectory=/opt/gaf/backend
EnvironmentFile=/opt/gaf/backend/.env.prod
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/gaf/venv/bin/gunicorn --config gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gaf/backend/staticfiles /opt/gaf/backend/media /opt/gaf/backend/logs

[Install]
WantedBy=multi-user.target
