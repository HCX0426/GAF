[Unit]
Description=GAF Celery Worker (async task execution)
After=network.target redis-server.service gaf-backend.service
Wants=redis-server.service

[Service]
Type=simple
User=gaf
Group=gaf
WorkingDirectory=/opt/gaf/backend
EnvironmentFile=/opt/gaf/backend/.env.prod
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/gaf/venv/bin/celery -A config worker --loglevel=info --concurrency=4
Restart=on-failure
RestartSec=10s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gaf/backend/logs

[Install]
WantedBy=multi-user.target
