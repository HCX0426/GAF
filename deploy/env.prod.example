# GAF production environment variables template.
# Copy to /opt/gaf/backend/.env.prod and edit values before starting services.

# Django core
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=gaf.example.com,localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gaf
DB_USER=gaf
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis (cache + channels + celery)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CHANNEL_LAYERS_HOST=127.0.0.1
CHANNEL_LAYERS_PORT=6379

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://gaf.example.com,http://localhost

# HTTPS (set to true when behind SSL terminator)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Gunicorn tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_PORT=8000

# JWT
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL (for CORS / email links)
FRONTEND_URL=https://gaf.example.com

# OAuth (optional — leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional — leave empty to fall back to console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@gaf.example.com
