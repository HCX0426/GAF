{
  "name": "get_email_simple",
  "description": "BD2 get_email pipeline without the sub_pipeline tail (call_back_to_main). Used by .cache/test_get_email_e2e.py for first-pass core-linkage validation. Original 9-node pipeline (resources/BrownDust II/pipelines/get_email.json) is the source of truth — this file is generated from it by removing the sub_pipeline node + dangling edge.",
  "version": "1.0.0",
  "metadata": {
    "original_base_res": [1920, 1080],
    "derived_from": "get_email.json",
    "trimmed_nodes": ["call_back_to_main"],
    "trimmed_reason": "sub_pipeline node uses legacy `pipeline_path` field; backend validator requires FK `pipeline_id` (Pipeline table). Tracked as known-limitation in spec28."
  },
  "entry_node": "open_mailbox",
  "nodes": [
    {
      "id": "open_mailbox",
      "config": {
        "threshold": 0.8,
        "roi": [1564, 28, 95, 61],
        "roi_coord_type": "base",
        "click_on_match": true,
        "template_id": "BrownDust II/templates/get_email/邮箱.png"
      },
      "node_type": "template_match"
    },
    {
      "id": "wait_regular_email",
      "config": {
        "mode": "ocr",
        "text": "普通邮箱",
        "roi": [214, 10, 333, 276],
        "roi_coord_type": "base",
        "check_interval": 0.5,
        "timeout": 15.0
      },
      "node_type": "wait"
    },
    {
      "id": "detect_empty_email",
      "config": {
        "threshold": 0.8,
        "roi": [1000, 370, 420, 389],
        "roi_coord_type": "base",
        "click_on_match": false,
        "template_id": "BrownDust II/templates/get_email/空邮箱标识.png"
      },
      "node_type": "template_match"
    },
    {
      "id": "branch_empty_email",
