        "true_branch": "claim_all_rewards",
        "false_branch": "claim_all_rewards"
      },
      "node_type": "branch"
    },
    {
      "id": "claim_all_rewards",
      "config": {
        "text": "全部领取",
        "roi": [1573, 969, 252, 61],
        "roi_coord_type": "base",
        "click_on_match": true
      },
      "node_type": "ocr"
    },
    {
      "id": "wait_mailbox_still_visible",
      "config": {
        "mode": "template",
        "template": "BrownDust II/templates/get_email/邮箱.png",
        "threshold": 0.8,
        "check_interval": 0.5,
        "timeout": 10.0
      },
      "node_type": "wait"
    },
    {
      "id": "click_back_dismiss_popup",
      "config": {
        "threshold": 0.8,
        "roi": [120, 20, 100, 66],
        "roi_coord_type": "base",
