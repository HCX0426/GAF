# ============================================
# GAF 前端环境配置模板
# 复制此文件为 .env 并按需修改
# 默认值已在 README / root .env.example 文档化 (VITE_BACKEND_HOST/PORT 等)
# ============================================

# 后端服务地址（开发服务器代理目标）
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# API 版本前缀（与 backend/app_info.py 中的 GAF_API_PREFIX 同步）
VITE_API_PREFIX=/api/v2

# 设备级 ADB 日志 WS 路径前缀（与 backend GAF_WS_DEVICES_PATH 同步，TD-366）
VITE_WS_DEVICES_PATH=/ws/devices/
