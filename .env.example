# ============================================
# GAF 环境配置模板
# 复制此文件为 .env 并按需修改
# 未修改的项将使用默认值
# ============================================

# ---------- 必需项 ----------
# Django 密钥（生产环境务必修改！开发环境可使用默认值）
# TD-334: 生产环境 (DJANGO_SETTINGS_MODULE=*prod) 若使用默认值会 RuntimeError fail-fast
SECRET_KEY=django-insecure-gaf-dev-change-me-in-production

# ---------- 可选项 ----------
# 数据库配置（默认 SQLite，零配置，无需修改）
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# TD-334: 生产环境 PostgreSQL 配置 (docker-compose 引用)
# DB_USER=gaf
# DB_PASSWORD=change-me-in-production
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Redis 配置（默认 localhost:6379）
REDIS_URL=redis://localhost:6379/0

# 后端服务端口
BACKEND_PORT=8000

# API 版本前缀（修改此处可同步后端、Agent、前端所有层的 API 路径）
# GAF_API_PREFIX=api/v2

# Agent WebSocket 协议路径（修改此处可同步所有层 Agent 的 WebSocket 连接路径）
# GAF_WS_AGENT_PATH=ws/protocol/agents/

# 前端开发服务器端口
FRONTEND_PORT=5173

# 前端完整 URL（OAuth 回调重定向目标，默认从 FRONTEND_PORT 推导）
# FRONTEND_URL=http://localhost:5173

# Django Debug 模式（生产环境设为 False）
# TD-334: 默认 False (安全优先), 开发环境 dev.py 会显式覆盖为 True
DEBUG=False

# 允许的主机（生产环境修改为实际域名）
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- LLM 配置（4 级降级链）----------
# 1) preferred: 在 DB 中配置（LLMConfig 单例），通过 /api/v2/settings/llm-config/ 管理
# 2) backup:    env 变量，preferred 失败时降级
# 3) local:     env 变量，本地 Ollama/vLLM（通常不需要 API Key）
# 4) offline:   硬编码兜底，总是返回占位内容（不调用网络）
#
# API Key 加密存储（推荐启用）：生成 key 后设为 GAF_LLM_API_KEY_ENCRYPTION_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 不设置则 API Key 明文存储（向后兼容）
# GAF_LLM_API_KEY_ENCRYPTION_KEY=
#
# Backup provider（可选）
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_PROVIDER=openai
# LLM_BACKUP_BASE_URL=
# LLM_BACKUP_MODEL=
#
# Local provider（可选，Ollama 示例）
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_API_KEY=local
# LLM_LOCAL_PROVIDER=custom
# LLM_LOCAL_MODEL=llama3

# ---------- 高级选项 ----------
# Celery Broker URL（默认使用 Redis）
# CELERY_BROKER_URL=redis://localhost:6379/1
# Celery Result Backend
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Django Channels Layer（默认使用 Redis）
# CHANNEL_LAYERS_HOST=localhost
# CHANNEL_LAYERS_PORT=6379

# JWT Token 有效期（分钟）
# TD-334: 默认 15 分钟, 对齐 docs/standards/api-contract.md (原默认 60)
# JWT_ACCESS_TOKEN_LIFETIME=15
# JWT Refresh Token 有效期（天）
# JWT_REFRESH_TOKEN_LIFETIME=7

# 日志级别
# LOG_LEVEL=INFO
# TD-334: 数据库日志处理器阈值 (WARNING+ 会写入 LogEntry 表)
# LOG_DB_LEVEL=WARNING
# TD-334: LogEntry 记录保留天数 (cleanup-old-logs celery beat 每日清理)
# LOG_RETENTION_DAYS=7

# ---------- GAF 应用行为配置 ----------
# TD-334: 这些变量在 base.py 中读取, 此前 .env.example 完全缺失
# 记住我功能有效期（天）
# GAF_REMEMBER_ME_DAYS=30
# 应用显示名称
# GAF_APP_NAME=GAF
# 统一响应包装 ({ code, message, data }), P0-2 默认 True (AI 可调试性: 一致结构便于错误分类)
# GAF_UNIFIED_RESPONSE_ENABLED=True
# 设备心跳轮询间隔（秒, 默认 30s, 过低会触发 GPU 驱动 TDR 黑屏）
# GAF_HEARTBEAT_INTERVAL=30
# Django runserver 启动时是否自动拉起 Agent 子进程 (默认 0=禁用, 启用会导致 autoreload 期间多 agent 堆叠)
# GAF_AUTO_START_AGENT=0

# 统一调试模式（控制所有 app 的调试行为）
# 设置为 1 启用：agent 保存标注调试截图、backend 传递 debug_mode=True、结构化日志全量输出
# GAF_DEBUG=0

# Localhost 旁路（允许无 Token 的本地请求通过中间件）
# 使用 gaf_services.ps1 管理时设为 1，避免本地开发时的 401/403 问题
# GAF_ALLOW_LOCALHOST_BYPASS=0

# ---------- OAuth 第三方登录（可选） ----------
# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# 回调地址需在 GitHub OAuth App 中配置为 http://localhost:8000/api/v2/accounts/auth/oauth/github/callback/
# GITHUB_REDIRECT_URI=http://localhost:8000/api/v2/accounts/auth/oauth/github/callback/
# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v2/accounts/auth/oauth/google/callback/
# 前端地址（OAuth 回调后重定向目标）
# FRONTEND_URL=http://localhost:5173

# Agent 心跳间隔（秒）
# 后端 HEARTBEAT_OFFLINE_SECONDS 应 >= 3x 此值
# GAF_HEARTBEAT_INTERVAL=10

# Agent 连接 Server 的 WebSocket 地址（默认 ws://127.0.0.1:8000/ws/protocol/agents/）
# GAF_SERVER_URL=ws://127.0.0.1:8000/ws/protocol/agents/

# Agent 调试截图根目录
# GAF_DEBUG_DIR=./debug

# Agent 截图缓存 TTL（秒，与后端 SCREENSHOT_CACHE_TTL 完全独立）
# GAF_AGENT_CACHE_TTL=300

# 前端后端通信地址（开发服务器代理目标）
# VITE_BACKEND_HOST=127.0.0.1
# VITE_BACKEND_PORT=8000

# 默认截图 JPEG 质量
# SCREENSHOT_JPEG_QUALITY=80

# ---------- TLS / SSL 加密通信（生产环境推荐启用） ----------
# 启用后 Agent 使用 wss:// 连接，建议同时配置以下证书路径：
# SSL 证书文件（PEM 格式，可与 KEY 合并为一个文件）
# SSL_CERT_FILE=certs/server-cert.pem
# SSL 私钥文件
# SSL_KEY_FILE=certs/server-key.pem
# HTTPS 监听端口
# HTTPS_PORT=8443

# ---------- 生产环境安全配置 (prod.py 读取) ----------
# TD-334: 此前 .env.example 完全缺失, 生产部署时只能从代码反查
# CORS 允许的前端源（逗号分隔, 默认 localhost:5173 + 127.0.0.1:5173）
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 重定向 (反向代理后端启用)
# SECURE_SSL_REDIRECT=false
# Cookie 仅 HTTPS 传输 (生产默认 true)
# SESSION_COOKIE_SECURE=true
# CSRF Cookie 仅 HTTPS 传输 (生产默认 true)
# CSRF_COOKIE_SECURE=true
# HSTS 强制 HTTPS 时长（秒, 默认 1 年）
# SECURE_HSTS_SECONDS=31536000

# ---------- 邮件配置 (prod.py 读取, 仅当 EMAIL_HOST 设置时启用 SMTP) ----------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@gaf.local

# ---------- Gunicorn 生产部署配置 (gunicorn.conf.py 读取) ----------
# TD-334: 生产容器化部署调优, 此前 .env.example 完全缺失
# 监听端口
# GUNICORN_PORT=8000
# worker 进程数 (默认 cpu*2+1)
# GUNICORN_WORKERS=9
# 每 worker 线程数
# GUNICORN_THREADS=2
# 请求超时（秒）
# GUNICORN_TIMEOUT=120
# keep-alive 时长（秒）
# GUNICORN_KEEPALIVE=5
# 单 worker 最大请求数 (防内存泄漏, 0=禁用)
# GUNICORN_MAX_REQUESTS=1000
# 最大请求抖动（避免所有 worker 同时重启）
# GUNICORN_MAX_REQUESTS_JITTER=50
# 优雅关闭超时（秒）
# GUNICORN_GRACEFUL_TIMEOUT=30
# 访问日志（- 表示输出到 stdout）
# GUNICORN_ACCESS_LOG=-
# 错误日志（- 表示输出到 stderr）
# GUNICORN_ERROR_LOG=-
# 日志级别
# GUNICORN_LOG_LEVEL=info

# ---------- 代码读取的 env 变量文档化 (check_deps_sync 强制, N197 补充) ----------
# 以下变量由代码 os.getenv 读取, 必须在模板声明 (新增代码 env 变量须同步补此段)
# app 路由路径段 (backend/config/app_info.py APP_ROUTES 读取, 修改需同步全部层)
# GAF_ROUTE_ACCOUNTS=accounts
# GAF_ROUTE_AGENTS=agents
# GAF_ROUTE_TASKS=tasks
# GAF_ROUTE_RESOURCES=resources
# GAF_ROUTE_MONITORS=monitors
# GAF_ROUTE_SKILLS=skills
# GAF_ROUTE_NOTIFICATIONS=notifications
# GAF_ROUTE_DEBUG=debug
# GAF_ROUTE_QA=qa
# GAF_ROUTE_PLUGINS=plugins
# GAF_ROUTE_PROTOCOL=protocol
# GAF_ROUTE_METRICS=metrics
# GAF_ROUTE_GAMESTATE=gamestate
# GAF_ROUTE_PIPELINE=pipeline
# GAF_ROUTE_SCHEDULER=scheduler
# GAF_ROUTE_EXECUTIONS=executions
# GAF_ROUTE_ANALYTICS=analytics
# GAF_ROUTE_SETTINGS=settings
# GAF_ROUTE_SEARCH=search
# GAF_ROUTE_AI=ai
# GAF_ROUTE_I18N=i18n
# GAF_ROUTE_LOGS=logs
# GAF_ROUTE_SCHEMA=schema
# GAF_ROUTE_DOCS=docs
# GAF_ROUTE_SYSTEM=system
# 设备级 ADB 日志流 WS 路径 (与前端 VITE_WS_DEVICES_PATH 同步, TD-366)
# GAF_WS_DEVICES_PATH=ws/devices/
# Celery 执行模式 (eager=任务在 daphne 内同步执行, 无 Worker 进程; celery=独立 Worker+Beat)
# GAF_CELERY_MODE=eager
# 调试目录根 (backend base.py DEBUG_DIR, 默认 <项目根>/debug)
# DEBUG_DIR=../debug
# 调试归档目录 (默认 <DEBUG_DIR>/archives)
# DEBUG_ARCHIVE_DIR=../debug/archives
# 调试归档保留天数 (cleanup_old_archives, 默认 30)
# DEBUG_ARCHIVE_RETENTION_DAYS=30
# Agent token (agent load_token_from_env 读取)
# GAF_AGENT_TOKEN=
# Agent API base (agent 端, 默认从 GAF_API_PREFIX 推导)
# GAF_AGENT_API_BASE=
# Agent 日志文件路径
# GAF_AGENT_LOG_FILE=
# 资源包根目录 (默认 <项目根>/resources)
# GAF_RESOURCE_ROOT=resources
